---
interface Props {
  airport: string; // Display name e.g. "Heathrow Airport"
  letterId?: string;
}
const { airport, letterId = 'letter-text' } = Astro.props;
---

<div class="letter-card">
  <div class="letter-card-header">
    <h2>Free Appeal Template</h2>
    <span class="airport-pill">{airport}</span>
  </div>
  <div class="letter-body" id={letterId}>
    <slot />
  </div>
  <div class="letter-footer">
    <button class="copy-btn" data-letter-id={letterId}>Copy template</button>
    <span class="copy-hint">Paste into the online appeal form and fill in your case details</span>
  </div>
  <span id={"copy-status-" + letterId} aria-live="polite" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;"> </span>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.letterId!;
      const el = document.getElementById(id);
      if (!el) return;
      navigator.clipboard.writeText(el.innerText).then(() => {
        const hint = btn.nextElementSibling as HTMLElement;
        const original = btn.textContent!;
        btn.textContent = 'Copied!';
        if (hint) hint.textContent = 'Now paste it into your appeal and add your details';
        const statusEl = document.getElementById('copy-status-' + id) as HTMLElement | null;
        if (statusEl) statusEl.textContent = 'Copied template to clipboard';
        setTimeout(() => {
          btn.textContent = original;
          if (hint) hint.textContent = 'Paste into your appeal and add your case details';
          if (statusEl) statusEl.textContent = '';
        }, 3000);
      });
    });
  });
</script>
