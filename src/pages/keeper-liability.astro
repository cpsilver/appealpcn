import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Keeper liability, POFA and why it matters";
const description = "Why keeper liability under POFA is the single most important issue in private airport parking appeals, and how to use it in your appeal.";
const canonical = "https://appealairportpcn.co.uk/keeper-liability/";

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Keeper liability and POFA: what it means for your airport PCN",
  "description": description,
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={articleSchema}>

  <nav class="breadcrumb">
    <div class="wrap">
      <a href="/">Home</a><span>›</span>
      <a href="/keeper-liability/">Keeper liability</a>
    </div>
  </nav>

  <section class="hero">
    <div class="wrap">
      <p class="hero-tag">Key legal concept · Short guide</p>
      <h1>Why keeper liability is the most important issue</h1>
      <p class="hero-sub">When you receive a private parking charge, the operator's ability to hold the registered keeper responsible is often the single decisive point. If keeper liability does not apply, the operator has a much weaker case.</p>
    </div>
  </section>

  <main>
    <div class="wrap">
      <div class="content-grid">
        <div>
          <section class="intro-section">
            <h2>Keeper liability, in plain language</h2>
            <p>Keeper liability is the legal route by which a parking operator can pursue the registered keeper of a vehicle for a charge that the driver may have incurred. In practice, operators prefer to pursue the keeper because it is often easier and cheaper than identifying and suing the driver.</p>
          </section>

          <section class="grounds-section">
            <h2>Why it matters more than other arguments</h2>
            <p>If keeper liability applies, the operator can send a Notice to Keeper and make a direct claim against the person listed as the vehicle's registered keeper. If keeper liability does not apply, the operator can only make a contractual claim against whoever was driving, which is harder to prove and easier to defend.</p>
            <p>Because of this difference, many appeals succeed simply by showing that the conditions required for keeper liability are not met. That is why a short, well-phrased appeal pointing out the lack of keeper liability is often the most effective first step.</p>
          </section>

          <section class="how-section">
            <h2>How keeper liability can be defeated</h2>
            <ul>
              <li><strong>Relevant land test:</strong> Schedule 4 to the Protection of Freedoms Act 2012 (POFA) limits keeper liability to "relevant land". Airport land subject to statutory control is frequently excluded, meaning operators cannot transfer liability to the keeper for drop-off charges.</li>
              <li><strong>Timely notice:</strong> Where keeper liability is possible, operators must serve a Notice to Keeper within the correct time limits. If those timescales are not met, keeper liability can fail.</li>
              <li><strong>Operator status:</strong> Who issued the notice matters. If the company is not entitled to enforce byelaws or is a contractor without proper standing, keeper liability may be challenged.</li>
            </ul>
          </section>

          <section class="practical-section">
            <h2>What to include in your appeal</h2>
            <p>When using the appeal template on the airport page, briefly state that you deny keeper liability where appropriate. Ask for proof that the land is "relevant land" under POFA, and request dates showing compliance with the notice requirements. Keep the statement short and direct; the appeal template on the airport page already contains the core language to make this point.</p>
            <p>If you want a stronger escalation, request the ANPR photographs and any contractual terms relied on by the operator. These pieces of evidence often show that the operator cannot lawfully transfer liability to the keeper.</p>
          </section>

          <section class="next-steps">
            <h2>Next steps</h2>
            <p>Start with the airport-specific appeal template on the relevant airport page, then link to this guide for a short explanation of why keeper liability matters. If your first-stage appeal is rejected, use the POPLA or IAS route where available. See our POPLA guide for escalation steps.</p>
            <p><a href="/blog/what-is-pofa-and-why-it-matters/">Read the POFA explainer</a> · <a href="/">Back to homepage</a></p>
          </section>

        </div>

        <aside class="sidebar">
          <div class="tips-card">
            <h3>Quick takeaway</h3>
            <p>Keeper liability is often the make-or-break point. If it does not apply, the operator has a much weaker claim. Start your appeal there.</p>
          </div>
        </aside>

      </div>
    </div>
  </main>

</BaseLayout>
