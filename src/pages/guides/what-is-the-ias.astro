<BaseLayout title={title} description={description} canonical={canonical} schema={schema}>
  <BlogPostHeader title="What is the IAS and how do I use it?" breadcrumbLabel="What is the IAS?" breadcrumbHref="/guides/what-is-the-ias/" updatedDate="NOVEMBER 2026" fixedUpdatedDate={true} />
