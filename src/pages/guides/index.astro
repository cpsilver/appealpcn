---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Airport PCN Appeal Guides | AppealAirportPCN";
const description = "Plain-English guides on POFA, POPLA, parking signs, consideration periods and the key legal cases that mean airport drop-off charges are almost always cancellable.";
const canonical = "https://appealairportpcn.co.uk/guides/";

const posts = [
  { href: '/guides/keeper-liability/', title: "Keeper liability: the issue that decides most airport PCNs", desc: "Understand when a parking company may pursue the registered keeper and why POFA's relevant-land rule matters for airport PCNs." },
  { href: '/guides/elliott-v-loake-why-it-doesnt-make-you-liable-as-the-keeper/', title: "Elliott v Loake: why it doesn't make you liable as the keeper", desc: "Parking operators often cite Elliott v Loake to frighten people into paying. But the case does not make the keeper automatically liable at an airport." },
  { href: '/guides/what-is-pofa-and-why-it-matters/', title: "What is POFA and why does it matter for parking appeals?", desc: "The Protection of Freedoms Act 2012 is the key piece of legislation that limits when a parking operator can pursue a registered keeper, and why airport PCNs usually fail under it." },
  { href: '/guides/relevant-land-airport-pcns/', title: "Why airport drop-off zones are not 'relevant land' under POFA", desc: "Airport land is subject to statutory control. This single legal fact is why operators like APCOA and NCP almost always fail when they try to pursue a keeper." },
  { href: '/guides/bpa-code-of-practice-signage/', title: "Private Parking Code of Practice: the signage rules", desc: "What the government Code says about entrance signs, parking charges, font sizes and airport byelaws." },
  { href: '/guides/five-minute-consideration-period/', title: "The consideration period: how long can you decide whether to park?", desc: "The new Code gives airport drop-off drivers at least 5 minutes to decide, with no grace period at the end." },
  { href: '/guides/what-is-popla/', title: "What is POPLA and how do I use it?", desc: "POPLA is the free, independent adjudication service for private parking charges. If your first appeal is rejected, this is your next step, and operators lose the vast majority of cases here on airport grounds." },
  { href: '/guides/what-is-the-ias/', title: "What is the IAS and how do I use it?", desc: "If an IPC member rejects your appeal, the IAS is your second-stage appeal. Who can use it, the deadline, what to include and what happens next." },
  { href: '/guides/thornton-v-shoe-lane-parking/', title: "Thornton v Shoe Lane Parking: why late-notified charges are unenforceable", desc: "A landmark 1971 Court of Appeal ruling established that a charge not communicated before a contract is formed cannot be part of that contract. It applies directly to airport drop-off charges." },
  { href: '/guides/what-responses-to-expect/', title: "What response can you expect from your appeal?", desc: "Real examples of operator replies to an airport PCN appeal: cancellation, a request for your driving licence, and a rejection. What each means and what to do next." },
  { href: '/guides/fake-airport-pcn-payment-sites/', title: "Fake airport PCN payment sites: how to spot them", desc: "Learn how to spot unofficial payment sites, fake texts and emails, and what to do if you have already paid one." },
  { href: '/guides/driving-licence-request/', title: "What to do if a parking company asks for your driving licence", desc: "After an airport PCN appeal, the operator may ask for a copy of your driving licence. Here is a real example, what the rules say, and a short reply." },
  { href: '/guides/fight-back-airport-drop-off-charges/', title: "Fight back: tell the government what airport drop-off charges do to drivers", desc: "Appealing helps you. Writing to the government helps everyone. Who to write to and a short message you can send." },
  { href: '/guides/report-times24-code-breach/', title: "How to report a parking company if you think it broke the Code", desc: "Who to tell, in what order, and what to include if you think a parking company broke the Code." },
  { href: '/guides/new-private-parking-code/', title: "The new Private Parking Code of Practice: what changes for drivers", desc: "What the government Code changes for airport drop-off drivers from 21 December 2026, and what it leaves as it is." },
];
---

<BaseLayout title={title} description={description} canonical={canonical}>

  <header class="page-banner guides-index-banner">
  <section class="guides-index-hero">
    <div class="wrap">
      <h1>Guides</h1>
      <p class="hero-sub">Plain-English explainers to airport drop-off PCNs. Here you'll find topics on the law, the rules, and the cases that mean airport drop-off charges are unenforcable.</p>
    </div>
  </section>
  </header>

  <main>
    <div class="wrap why-works-list">
      <div class="blog-grid">
        {posts.map(({ href, title, desc }) => (
          <a href={href} class="blog-card">
            <h3>{title}</h3>
            <p>{desc}</p>
            <span class="airport-card-arrow">Read more →</span>
          </a>
        ))}
      </div>
    </div>
  </main>

</BaseLayout>
