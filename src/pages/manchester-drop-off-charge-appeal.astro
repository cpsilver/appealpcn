---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { currentMonthYear } from '../utils/site-date';
import AppealLetter from '../components/AppealLetter.astro';
import AirportSidebar from '../components/AirportSidebar.astro';

const title = "Appeal Your Manchester Airport Drop-Off Charge | Free PCN Appeal Letter 2026";
const description = "Received a parking charge notice for dropping off at Manchester Airport? Use our free appeal letter template and beat your PCN in minutes.";
const canonical = "https://appealairportpcn.co.uk/manchester-drop-off-charge-appeal/";

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "How to Appeal a Manchester Airport Drop-Off Charge",
  "description": "Step-by-step guide and free appeal letter template for challenging a Manchester Airport drop-off PCN.",
  "author": { "@type": "Organization", "name": "AppealPCN" },
  "publisher": { "@type": "Organization", "name": "AppealAirportPCN.co.uk" },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much is the Manchester drop-off charge?",
      "acceptedAnswer": { "@type": "Answer", "text": "At Terminal 2, the charge is £5.50 for 5 minutes, £6.50 for 10 minutes, or £25 for up to 30 minutes. Charges can differ between terminals, so check the terminal shown on your notice." }
    },
    {
      "@type": "Question",
      "name": "Can I appeal a Manchester drop-off charge?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. Appeal to the operator using the instructions on your PCN. If your appeal is rejected, check whether the notice gives you access to POPLA." }
    },
    {
      "@type": "Question",
      "name": "I was only there for a few minutes, do I still have to pay?",
      "acceptedAnswer": { "@type": "Answer", "text": "If you were genuinely in and out quickly, the ANPR timestamps on your PCN should reflect that. If the times shown are longer than your actual stay, ask for the photos and appeal the charge." }
    },
    {
      "@type": "Question",
      "name": "What if my appeal is rejected?",
      "acceptedAnswer": { "@type": "Answer", "text": "If the operator rejects your appeal, check your rejection letter for a POPLA verification code. You can then make a free second-stage appeal." }
    },
  ],
};

const tips = [
  { heading: 'Act within 28 days', body: 'The deadline to appeal is 28 days from the notice date. Miss it and you lose the right to formally appeal.' },
  { heading: 'Use recorded post', body: "If sending by post, always use Royal Mail Tracked or Signed For. Keep your proof of postage." },
  { heading: 'Request the evidence', body: 'Ask for the ANPR photographs in your appeal. Operators must provide them, and they sometimes reveal errors.' },
  { heading: 'POPLA is free', body: "If rejected, you can escalate to POPLA at no cost. Do not pay before exhausting this option." },
  { heading: 'Keep a copy', body: "Save or print a copy of everything you send. You'll need it if the case escalates." },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPage="manchester"
  schema={[articleSchema, faqSchema]}
>

  <section class="hero">
    <div class="wrap">
      <nav class="breadcrumb">
        <div class="wrap"><a href="/">Home</a><span>›</span><a href="/manchester-drop-off-charge-appeal/">Manchester</a></div>
      </nav>
      <h1>Appeal Your Manchester Airport Drop-Off Charge</h1>
      <p class="hero-sub">Received an unexpected parking charge notice after dropping someone off at Manchester? You may well have grounds to challenge it, and our free template makes the process straightforward.</p>
  </section>

  <div class="wrap"><AdSlot type="leaderboard" /></div>

  <main>
    <div class="wrap">
      <div class="main-content">
        <div class="content-grid">

          <AirportSidebar current="Manchester Airport" tips={tips} />

          <div class="airport-main-column">
            <AppealLetter airport="Manchester Airport">
              <p>I appeal as the registered keeper of the vehicle. I am not obliged to identify the driver and decline to do so.</p>
              <p>1. The parking charge is not notified until after the contract is entered into. Under the principles established by the Court of Appeal in Thornton v Shoe Lane Parking [1971] 2 QB 163, a term introduced after a contract has been formed does not become part of that contract. The charge therefore forms no part of any contract between the driver and the operator.</p>
              <p>2. The signage is not compliant with the BPA Code of Practice. The charging terms were not displayed clearly, prominently, or legibly at a point where the driver could have made an informed decision to avoid the zone before entering it. No valid contract was formed.</p>
              <p>3. The vehicle was present in the drop-off zone for no more than 5 minutes. The driver is entitled to the 5-minute consideration period expressly mandated by the BPA Code of Practice, during which no charge may be levied.</p>
              <p>4. Under the Protection of Freedoms Act 2012, keeper liability cannot be transferred for breaches of the operator's own statutory duties or breaches of the Code of Practice. The operator has failed to comply with the requirement to display adequate signage and therefore cannot pursue the registered keeper.</p>
              <p>5. The charge is not a genuine pre-estimate of loss and is therefore an unenforceable penalty at common law. The operator has suffered no identifiable loss as a result of the vehicle's presence in the drop-off zone.</p>
              <p>Any one of the above grounds is sufficient on its own to require cancellation of the PCN. I require this charge to be cancelled and invite the operator to confirm cancellation in writing.</p>
            </AppealLetter>

            <div class="instructions-card">
              <h2>How to use this appeal template</h2>
              <div class="step-row"><div class="step-num">1</div><div class="step-text">Click <strong>"Copy template"</strong> above, the full appeal is copied to your clipboard.</div></div>
              <div class="step-row"><div class="step-num">2</div><div class="step-text">Log into the operator's online appeal system (or open your PCN) and paste the template into the appeal text box.</div></div>
              <div class="step-row"><div class="step-num">3</div><div class="step-text">Submit and wait for a decision. The operator must respond within 35 days.</div></div>
              <div class="step-row"><div class="step-num">4</div><div class="step-text">If rejected, request your POPLA code and escalate to the free, independent adjudicator, operators lose the vast majority of cases on these grounds.</div></div>
            </div>

            <div class="airport-info-panel">
            <section class="intro-section">
              <h2>Manchester drop-off charge appeal</h2>
              <p>Got a PCN for dropping someone off at Manchester? It's highly likely you can cancel it. Use the free template above.</p>

              <h3>The charge</h3>
              <p>Manchester has paid drop-off areas at the terminals and a separate free drop-off area.</p>
              <p>At Terminal 2, the current charge is <strong>£5.50</strong> for <strong>5 minutes</strong>, <strong>£6.50</strong> for <strong>10 minutes</strong>, or <strong>£25</strong> for up to <strong>30 minutes</strong>.</p>
              <p>The maximum stay in the paid drop-off area is <strong>30 minutes</strong>.</p>
              <p>You must pay online by midnight the following day.</p>
              <p>This is a <strong>private parking charge</strong>. It is not a council fine.</p>

              <h3>Why you can appeal</h3>
              <p>You do not need to name who was driving, nor do they have any right to ask. This means that they cannot enforce keeper liability, as they can only confirm that you're the owner of the vehicle - <strong>not the driver.</strong></p>
              <p>Points that can help:</p>

              <ul>
                <li><strong>Unclear signs.</strong> Check whether the charge and its terms were clear before you entered.</li>
                <li><strong>You were not in the zone.</strong> Compare the photos with the location shown by the airport.</li>
                <li><strong>Emergency or exceptional reasons.</strong> Explain what happened and include proof.</li>
                <li><strong>The charge was already paid.</strong> Include your payment confirmation.</li>
              </ul>
            </section>

            <section class="faq-section">
              <h2>Questions</h2>

              <details>
                <summary>How much is the drop-off charge?</summary>
                <div class="faq-answer"><p>At Terminal 2, it is <strong>£5.50</strong> for <strong>5 minutes</strong>, <strong>£6.50</strong> for <strong>10 minutes</strong>, or <strong>£25</strong> for up to <strong>30 minutes</strong>. Charges can differ between terminals, so check the terminal shown on your notice.</p></div>
              </details>
              <details>
                <summary>Can I appeal if I didn't read the signs?</summary>
                <div class="faq-answer"><p>Yes. The issue is whether the charge and its terms were clear before you entered the zone. If the signs were unclear or the area boundary was confusing, that is a valid appeal point.</p></div>
              </details>
              <details>
                <summary>I was only there for a few minutes, do I still have to pay?</summary>
                <div class="faq-answer"><p>Yes, if the vehicle entered the paid drop-off zone. If the ANPR times or location look wrong, ask for the photos and challenge the charge.</p></div>
              </details>
              <details>
                <summary>What happens if my appeal is rejected?</summary>
                <div class="faq-answer"><p>Check the rejection letter. If it gives you a POPLA verification code, you can make a free second-stage appeal.</p></div>
              </details>
            </section>

            <section class="grounds-section">
              <h2>Quick tips</h2>
              <ul>
                <li><strong>Check the terminal.</strong> Manchester has different drop-off arrangements.</li>
                <li><strong>Check the deadline.</strong> Use the date on your PCN.</li>
                <li><strong>Use the free drop-off area</strong> if you are making a future visit and do not need to stop at the terminal.</li>
                <li><strong>Keep copies.</strong> Save the PCN, photos and correspondence.</li>
              </ul>
            </section>

            <section class="grounds-section sources-section">
              <h2>Sources</h2>
              <ul>
                <li>Manchester Airport, <strong>Pick Up and Drop Off</strong>: <a href="https://www.manchesterairport.co.uk/getting-to-and-from/pick-up-and-drop-off/" target="_blank" rel="noreferrer">https://www.manchesterairport.co.uk/getting-to-and-from/pick-up-and-drop-off/</a></li>
                <li>Manchester Airport, <strong>Fees and Charges</strong>: <a href="https://www.manchesterairport.co.uk/about-us/publications/fees-and-charges/" target="_blank" rel="noreferrer">https://www.manchesterairport.co.uk/about-us/publications/fees-and-charges/</a></li>
                <li>Manchester Airport, <strong>Free Drop Off Terms and Conditions</strong>: <a href="https://www.manchesterairport.co.uk/terms-and-conditions/free-drop-off-terms-and-conditions/" target="_blank" rel="noreferrer">https://www.manchesterairport.co.uk/terms-and-conditions/free-drop-off-terms-and-conditions/</a></li>
                <li>Protection of Freedoms Act 2012, <strong>Schedule 4</strong>: <a href="https://www.legislation.gov.uk/ukpga/2012/9/schedule/4" target="_blank" rel="noreferrer">https://www.legislation.gov.uk/ukpga/2012/9/schedule/4</a></li>
                <li>POPLA, <strong>Appeal guide</strong>: <a href="https://www.popla.co.uk/appeal-guide" target="_blank" rel="noreferrer">https://www.popla.co.uk/appeal-guide</a></li>
                <li>GOV.UK, <strong>CCJs and your credit rating</strong>: <a href="https://www.gov.uk/county-court-judgments-ccj-for-debt/ccjs-and-your-credit-rating" target="_blank" rel="noreferrer">https://www.gov.uk/county-court-judgments-ccj-for-debt/ccjs-and-your-credit-rating</a></li>
              </ul>
              <p>Manchester's current published Terminal 2 tariff is <strong>£5.50 for 5 minutes</strong>, <strong>£6.50 for 10 minutes</strong> and <strong>£25 for up to 30 minutes</strong>.</p>
            </section>

            </div>

            <div class="disclaimer">
              <strong>Disclaimer:</strong> AppealAirportPCN.co.uk is a free information resource for UK drivers. Nothing on this site constitutes legal advice. Templates are provided as a starting point, always review your specific circumstances. For complex cases, consider consulting a solicitor or Citizens Advice.
            </div>
          </div>

        </div>
      </div>
    </div>
  </main>

</BaseLayout>
