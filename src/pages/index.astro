---
import BaseLayout from '../layouts/BaseLayout.astro';
import { currentMonthYear } from '../utils/site-date';

const title = "Beat Your Airport Drop-Off Charge | Free PCN Appeals";
const description = "Free appeal templates for UK airport drop-off charges. Strong legal grounds, clear guidance, and copy-ready appeal templates you can use in minutes.";
const canonical = "https://appealairportpcn.co.uk/";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "AppealAirportPCN.co.uk",
  "url": "https://appealairportpcn.co.uk",
  "description": description,
};

const airports = [
  { href: '/heathrow-drop-off-charge-appeal/', tag: 'Terminals 2–5', name: 'Heathrow Drop-Off Charge Appeal', desc: "APCOA cannot establish keeper liability at Heathrow, the drop-off zone is not 'relevant land' under POFA. Full guide and legal grounds." },
  { href: '/gatwick-drop-off-charge-appeal/',  tag: 'North & South Terminal', name: 'Gatwick Drop-Off Charge Appeal', desc: "NCP cannot hold a registered keeper liable at Gatwick Airport. The land is under statutory control. Full guide and legal grounds." },
  { href: '/stansted-drop-off-charge-appeal/', tag: 'Single Terminal', name: 'Stansted Drop-Off Charge Appeal', desc: "One of the most contested drop-off zones in the UK. Strong signage and POFA arguments apply. Full guide and legal grounds." },
  { href: '/luton-drop-off-charge-appeal/',    tag: 'Single Terminal', name: 'Luton Drop-Off Charge Appeal', desc: "Luton's road layout makes it impossible to avoid the charge zone, a well-established and frequently upheld appeal argument." },
  { href: '/manchester-drop-off-charge-appeal/', tag: 'Single Terminal', name: 'Manchester Drop-Off Charge Appeal', desc: "One of the UK's busiest regional airports. Strong POFA and signage arguments apply. Full guide and legal grounds." },
  { href: '/birmingham-drop-off-charge-appeal/', tag: 'Single Terminal', name: 'Birmingham Drop-Off Charge Appeal', desc: "West Midlands' major airport hub. POFA keeper liability rules apply. Full guide and legal grounds." },
];

const blogPosts = [
  { href: '/blog/keeper-liability/', title: "Keeper liability: the issue that decides most airport PCNs", desc: "Understand when a parking company may pursue the registered keeper and why POFA's relevant-land rule matters for airport PCNs." },
  { href: '/blog/elliott-v-loake-why-it-doesnt-make-you-liable-as-the-keeper/', title: "Elliott v Loake: why it doesn't make you liable as the keeper", desc: "A scare-letter reference to Elliott v Loake does not make the keeper liable at an airport. The company must still prove who was driving." },
  { href: '/blog/what-is-pofa-and-why-it-matters/', title: "What is POFA and why does it matter for parking appeals?", desc: "The Protection of Freedoms Act 2012 is the key piece of legislation that limits when a parking operator can pursue a registered keeper." },
  { href: '/blog/relevant-land-airport-pcns/', title: "Why airport drop-off zones are not 'relevant land' under POFA", desc: "Airport land is subject to statutory control, which means private operators cannot use POFA to transfer liability to the keeper." },
  { href: '/blog/bpa-code-of-practice-signage/', title: "BPA Code of Practice: the signage rules operators must follow", desc: "The BPA's own rules require clear, prominent signage before a driver commits to entering a charge zone. Most airport signs fail this test." },
  { href: '/blog/five-minute-consideration-period/', title: "The 5-minute consideration period: what it means for your appeal", desc: "BPA-accredited operators must allow drivers a 5-minute grace period to read signs and leave. Here's how to use this in your appeal." },
  { href: '/blog/what-is-popla/', title: "What is POPLA and how do I use it?", desc: "POPLA is the free, independent appeals service for private parking charges. If your first appeal fails, this is your next step." },
  { href: '/blog/thornton-v-shoe-lane-parking/', title: "Thornton v Shoe Lane Parking: why late-notified charges are unenforceable", desc: "A landmark Court of Appeal case established that charges notified after a contract is entered into cannot form part of that contract." },
  { href: '/blog/what-responses-to-expect/', title: "What response can you expect from your appeal?", desc: "Real examples of operator responses, including cancellations, rejections, and what the most likely outcome looks like in practice." },
];

const svgClipboard = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width:15px;height:15px;flex-shrink:0"><path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" /></svg>`;
