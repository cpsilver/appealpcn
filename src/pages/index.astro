<script>
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const tabPanels = document.querySelectorAll<HTMLElement>('.tab-panel');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab!;
      tabBtns.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-selected','false'); });
      tabPanels.forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      btn.setAttribute('aria-selected','true');
      document.getElementById(`panel-${target}`)?.classList.add('active');
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.clipboard-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const el = document.getElementById(btn.dataset.target!);
      if (!el) return;
      navigator.clipboard.writeText(el.innerText).then(() => {
        const saved = btn.innerHTML;
        const hint = btn.nextElementSibling as HTMLElement;
        btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" style="width:15px;height:15px"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg> Copied!`;
        if (hint) hint.textContent = 'Pasted and ready to send';
        // ensure there is a single live region for accessibility
        let live = document.getElementById('copy-live-region');
        if (!live) {
          live = document.createElement('div');
          live.id = 'copy-live-region';
          live.setAttribute('aria-live', 'polite');
          live.style.position = 'absolute';
          live.style.left = '-9999px';
          document.body.appendChild(live);
        }
        (live as HTMLElement).textContent = 'Copied to clipboard';
        setTimeout(() => { btn.innerHTML = saved; if (hint) hint.textContent = 'Paste into your appeal form or email, no editing needed'; (live as HTMLElement).textContent = ''; }, 3000);
      });
    });
  });
</script>
