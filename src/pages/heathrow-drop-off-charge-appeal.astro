---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import AppealLetter from '../components/AppealLetter.astro';
import AirportSidebar from '../components/AirportSidebar.astro';

const title = "Appeal Your Heathrow Airport Drop-Off Charge | Free PCN Appeal Letter 2026";
const description = "Received a parking charge notice for dropping off at Heathrow Airport? Use our free appeal letter template and beat your PCN in minutes.";
const canonical = "https://appealairportpcn.co.uk/heathrow-drop-off-charge-appeal/";

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "How to Appeal a Heathrow Airport Drop-Off Charge",
  "description": "Step-by-step guide and free appeal letter template for challenging a Heathrow Airport drop-off PCN.",
  "author": { "@type": "Organization", "name": "AppealPCN" },
  "publisher": { "@type": "Organization", "name": "AppealAirportPCN.co.uk" },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much is the Heathrow Airport drop-off charge?",
      "acceptedAnswer": { "@type": "Answer", "text": "As of 2025, Heathrow charges £5 for up to 10 minutes and £7 for up to 30 minutes in the designated drop-off zone, enforced via ANPR cameras." }
    },
    {
      "@type": "Question",
      "name": "Can I appeal a Heathrow drop-off charge?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. You have 28 days to submit a formal appeal. If rejected, you can escalate free of charge to POPLA, the independent adjudicator." }
    },
    {
      "@type": "Question",
      "name": "What are valid grounds to appeal a Heathrow PCN?",
      "acceptedAnswer": { "@type": "Answer", "text": "Valid grounds include: unclear or obstructed signage, ANPR camera error, the vehicle being driven by someone else, a genuine emergency, or that the charge was disproportionate to the duration of stay." }
    },
    {
      "@type": "Question",
      "name": "What happens if Heathrow rejects my appeal?",
      "acceptedAnswer": { "@type": "Answer", "text": "If your informal appeal is rejected, you can escalate to POPLA completely free of charge. Operators lose a significant proportion of POPLA cases, particularly where signage compliance is questioned." }
    },
  ],
};

const tips = [
  { heading: 'Act within 28 days', body: 'The deadline to appeal is 28 days from the notice date. Miss it and you lose the right to formally appeal.' },
  { heading: 'Use recorded post', body: "If sending by post, always use Royal Mail Tracked or Signed For. Keep your proof of postage." },
  { heading: 'Request the evidence', body: 'Ask for the ANPR photographs in your appeal. Operators must provide them, and they sometimes reveal errors.' },
  { heading: 'POPLA is free', body: "If rejected, you can escalate to POPLA at no cost. Do not pay before exhausting this option." },
  { heading: 'Keep a copy', body: "Save or print a copy of everything you send. You'll need it if the case escalates." },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPage="heathrow"
  schema={[articleSchema, faqSchema]}
>

  <nav class="breadcrumb">
    <div class="wrap">
      <a href="/">Home</a><span>›</span>
      <a href="/heathrow-drop-off-charge-appeal/">Heathrow</a>
    </div>
  </nav>

  <section class="hero">
    <div class="wrap">
      <p class="hero-tag">Heathrow Airport · Free PCN Appeal Template · Updated August 2026</p>
      <h1>Appeal Your Heathrow Airport Drop-Off Charge</h1>
      <p class="hero-sub">Received an unexpected parking charge notice after dropping someone off at Heathrow? You may well have grounds to challenge it, and our free template makes the process straightforward.</p>
      <div class="hero-stats">
        <div class="stat-block"><span class="stat-n">FREE</span><span class="stat-l">To appeal</span></div>
        <div class="stat-block"><span class="stat-n">28 days</span><span class="stat-l">To appeal</span></div>
        <div class="stat-block"><span class="stat-n">5 min</span><span class="stat-l">To complete</span></div>
      </div>
      </div>
    </div>
  </section>

  <main>
    <div class="wrap">
      <AdSlot type="leaderboard" />
      <div class="main-content">
        <div class="content-grid">

          <div>
            <div class="instructions-card">
              <h2>How to use this appeal template</h2>
              <div class="step-row"><div class="step-num">1</div><div class="step-text">Click <strong>"Copy template"</strong> below, the full appeal is copied to your clipboard.</div></div>
              <div class="step-row"><div class="step-num">2</div><div class="step-text">Log into the operator's online appeal system (or open your PCN) and paste the template into the appeal text box.</div></div>
              <div class="step-row"><div class="step-num">3</div><div class="step-text">Replace every <strong style="color:var(--accent)">highlighted field</strong> (in square brackets) with your details: name, vehicle registration, PCN reference, and incident date.</div></div>
              <div class="step-row"><div class="step-num">4</div><div class="step-text">Submit and wait for a decision. The operator must respond within 35 days.</div></div>
              <div class="step-row"><div class="step-num">5</div><div class="step-text">If rejected, request your POPLA code and escalate to the free, independent adjudicator, operators lose the vast majority of cases on these grounds.</div></div>
            </div>

            <AppealLetter airport="Heathrow Airport">
              <p>I appeal as the registered keeper of the vehicle. I am not obliged to identify the driver and decline to do so.</p>
              <p>1. APCOA Parking is unable to transfer the driver's liability (if any) to the keeper under Schedule 4 to the Protection of Freedoms Act 2012 ("POFA") because the drop-off zones at Heathrow Airport are not 'relevant land' as defined in POFA. Airport land subject to statutory control falls outside the scope of Schedule 4, and APCOA therefore has no basis on which to pursue the registered keeper.</p>
              <p>Furthermore, as keeper I am entitled to all the defences available to the driver, including (without limitation) the following:</p>
              <p>2. The parking charge is not notified until after the contract is entered into. Under the principles established by the Court of Appeal in Thornton v Shoe Lane Parking [1971] 2 QB 163, a term introduced after a contract has been formed does not become part of that contract. The charge therefore forms no part of any contract between the driver and APCOA.</p>
              <p>3. The signage is not compliant with the BPA Code of Practice. The charging terms were not displayed clearly, prominently, or legibly at a point where the driver could have made an informed decision to avoid the zone before entering it. No valid contract was formed.</p>
              <p>4. The vehicle was present in the drop-off zone for no more than 5 minutes. The driver is entitled to the 5-minute consideration period expressly mandated by the BPA Code of Practice, during which no charge may be levied.</p>
              <p>5. The charge is not a genuine pre-estimate of loss and is therefore an unenforceable penalty at common law. APCOA has suffered no identifiable loss as a result of the vehicle's presence in the drop-off zone.</p>
              <p>Any one of the above grounds is sufficient on its own to require cancellation of the PCN. I require this charge to be cancelled and invite APCOA to confirm cancellation in writing.</p>
            </AppealLetter>

            <section class="intro-section">
              <h2>Heathrow drop-off charge appeal</h2>
              <p>Got a PCN for dropping someone off at Heathrow? It's highly likely you can cancel it. Use the free template above.</p>

              <h3>The charge</h3>
              <p>Heathrow uses ANPR cameras in its terminal drop-off zones.</p>
              <p>The charge is <strong>£7</strong> each time you enter a terminal drop-off zone. You must pay by midnight the following day.</p>
              <p>The operator is <strong>APCOA</strong>.</p>
              <p>This is a <strong>private parking charge</strong>. It is not a council fine.</p>

              <h3>Why you can appeal</h3>
              <p>Heathrow's terminal drop-off zones are on roads regulated by traffic orders and airport byelaws. This can affect whether the Protection of Freedoms Act 2012 can be used to hold the keeper liable.</p>
              <p>You do not need to name who was driving, nor do they have any right to ask. This means that they cannot enforce keeper liability, as they can only confirm that you're the owner of the vehicle - <strong>not the driver.</strong></p>
              <p>Other points can also help:</p>

              <ul>
                <li><strong>Unclear signs.</strong> Check whether the charge and its terms were clear before you entered the zone.</li>
                <li><strong>ANPR timing errors.</strong> Ask for the photos if the recorded entry or exit time looks wrong.</li>
                <li><strong>You were not in the zone.</strong> Compare the photos with the location shown on Heathrow's website.</li>
                <li><strong>Emergency or exceptional reasons.</strong> Explain what happened and include proof if you have it.</li>
                <li><strong>The charge was already paid.</strong> Include your payment confirmation.</li>
              </ul>
            </section>

            <section class="faq-section">
              <h2>Questions</h2>

              <details>
                <summary>How much is the charge?</summary>
                <div class="faq-answer"><p>£7 each time you enter a terminal drop-off zone. Heathrow's charge is <strong>£7 per visit</strong>. It applies each time you enter a terminal drop-off zone and is payable by midnight the following day.</p></div>
              </details>
              <details>
                <summary>Can I appeal?</summary>
                <div class="faq-answer"><p>Yes. Appeal to the operator using the instructions on your PCN. If your appeal is rejected, check whether the notice gives you access to POPLA.</p></div>
              </details>
              <details>
                <summary>What is POPLA?</summary>
                <div class="faq-answer"><p>POPLA is an independent appeals service for private parking charges. You normally need a POPLA verification code from the parking operator.</p></div>
              </details>
              <details>
                <summary>What if I ignore it?</summary>
                <div class="faq-answer"><p>Do not ignore it. The operator can take legal action to recover an unpaid charge.</p></div>
              </details>
              <details>
                <summary>I wasn't driving. Am I liable?</summary>
                <div class="faq-answer"><p>Not necessarily. POFA keeper liability has specific rules and does not apply to every type of airport land. Check the land and the wording of your PCN before deciding what to do.</p></div>
              </details>
              <details>
                <summary>Will it hurt my credit score?</summary>
                <div class="faq-answer"><p>A PCN by itself is not a County Court Judgment. A CCJ can be recorded on the public register and can affect your ability to get credit.</p></div>
              </details>
            </section>

            <section class="grounds-section">
              <h2>Quick tips</h2>
              <ul>
                <li><strong>Check the deadline.</strong> Use the date on your PCN.</li>
                <li><strong>Ask for the photos.</strong> They can show the vehicle location and ANPR times.</li>
                <li><strong>Keep proof.</strong> Save your appeal and any reply.</li>
                <li><strong>Do not ignore the PCN.</strong> Follow the appeal instructions on the notice.</li>
                <li><strong>Keep copies.</strong> Save the PCN, photos, appeal and response.</li>
              </ul>
            </section>

            <section class="grounds-section">
              <h2>Sources</h2>
              <ul>
                <li>Heathrow, <strong>Terminal Drop-Off Charge</strong>: <a href="https://www.heathrow.com/transport-and-directions/terminal-drop-off-charge" target="_blank" rel="noreferrer">https://www.heathrow.com/transport-and-directions/terminal-drop-off-charge</a></li>
                <li>Heathrow, <strong>Terminal Drop-Off Charge Terms and Conditions</strong>: <a href="https://www.heathrow.com/terms-and-conditions/terminal-drop-off-charge-terms-and-conditions" target="_blank" rel="noreferrer">https://www.heathrow.com/terms-and-conditions/terminal-drop-off-charge-terms-and-conditions</a></li>
                <li>Heathrow, <strong>Byelaws</strong>: <a href="https://www.heathrow.com/company/doing-business-with-heathrow/flight-conditions-of-use/heathrow-byelaws" target="_blank" rel="noreferrer">https://www.heathrow.com/company/doing-business-with-heathrow/flight-conditions-of-use/heathrow-byelaws</a></li>
                <li>Protection of Freedoms Act 2012, <strong>Schedule 4</strong>: <a href="https://www.legislation.gov.uk/ukpga/2012/9/schedule/4" target="_blank" rel="noreferrer">https://www.legislation.gov.uk/ukpga/2012/9/schedule/4</a></li>
                <li>POPLA, <strong>Appeal guide</strong>: <a href="https://www.popla.co.uk/appeal-guide" target="_blank" rel="noreferrer">https://www.popla.co.uk/appeal-guide</a></li>
                <li>GOV.UK, <strong>CCJs and your credit rating</strong>: <a href="https://www.gov.uk/county-court-judgments-ccj-for-debt/ccjs-and-your-credit-rating" target="_blank" rel="noreferrer">https://www.gov.uk/county-court-judgments-ccj-for-debt/ccjs-and-your-credit-rating</a></li>
              </ul>
              <p>Heathrow's current charge is <strong>£7 per visit</strong>. It increased from <strong>£6</strong> to <strong>£7</strong> on <strong>1 January 2026</strong>.</p>
            </section>

            <div class="disclaimer">
              <strong>Disclaimer:</strong> AppealAirportPCN.co.uk is a free information resource for UK drivers. Nothing on this site constitutes legal advice. Templates are provided as a starting point, always review your specific circumstances. For complex cases, consider consulting a solicitor or Citizens Advice.
            </div>
          </div>

          <AirportSidebar current="Heathrow Airport" tips={tips} />

        </div>
      </div>
    </div>
  </main>

</BaseLayout>
